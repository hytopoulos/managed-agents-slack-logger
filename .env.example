# --- Anthropic / Managed Agents ---
# Create an API key in the Console. Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Needed for webhook_server.py. The whsec_ secret shown once when you register
# the webhook endpoint in Console > Manage > Webhooks.
ANTHROPIC_WEBHOOK_SIGNING_KEY=whsec_...

# --- Slack ---
# Bot token (xoxb-...). Scopes: chat:write, channels:read (+ groups:read for
# private channels). Invite the bot to the channel.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=agent-sessions

# --- State (when hosting, point at a mounted volume so it survives redeploys) ---
LOGGER_STATE_DB=/data/state.db

# --- Optional tuning ---
# Comma-separated event types to log, or * for everything (default).
LOGGER_EVENT_FILTER=*
# Max characters per Slack reply before truncation.
LOGGER_MAX_TEXT=2800
